{% extends "base.html.jinja2" %}
{% block extrahead %}
    <title>Home - {{base_title}}</title>
{% endblock extrahead %}
{% block content %}
    <h1>{{base_title}}</h1>

    <p>
    {% if user != None %}
        Logged in as <b>{{user}}</b>
        <button id="logout-button">Log out</button>
    {% else %}
        <!--<button id="login-button">Log in</button>-->
        <a href="/login">Log in</a>
    {% endif %}

    </p>
    <p style="font-size: 18pt;">
    <b>Please read the <a href="/howto">instructions</a> before starting!</b>
    </p>
    <!-- <div class="radargram-index"> -->
    {% for glacier_key, glacier_radargrams in all_radargrams.items() %}
        <div class="radargram-perglacier">
            <h2>{{glacier_radargrams._meta.nice_name}}</h2>
            <p>This glacier has a total of {{glacier_radargrams._meta.n_total_submissions}}  {{"submission" if glacier_radargrams._meta.n_total_submissions == 1 else "submissions"}}</p>
            <div class="radargram-index">
                {% for radar_key, values in glacier_radargrams.items() %}
                    {% if radar_key != "_meta" %}

                    <a href="/digitize/{{radar_key}}" class="radargram-choice radargram-choice-{% if user == None %}anonymous{% elif values.n_submitted_by_user > 0 %}finished{% else %}unfinished{% endif %}">
                        <b>{{radar_key}}</b><br>
                        <list>
                            <li>Done by {{values.n_total_submissions}} {{"person" if values.n_total_submissions == 1 else "people"}}.</li>
                            {% if user != None %}
                                {% if values.n_submitted_by_user >= 2 %}
                                    <li>Done by you ({{values.n_submitted_by_user}}x)!</li>
                                {% elif values.n_submitted_by_user == 1 %}
                                    <li>Done by you!</li>
                                {% else %}
                                    <li>Not done by you</li>
                                {% endif %}
                            {% endif %}
                            <li>Length: {{values.length_km_rounded}} km.</li>
                        </list>
                        <img loading="lazy" src="{{values.thumbnail}}"></img>
                    </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endfor %}
    <script src="{{ url_for('static', filename='index.js') }}"></script>
{% endblock content %}
