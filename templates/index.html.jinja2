{% extends "base.html.jinja2" %}
{% block extrahead %}
    <title>Home - {{base_title}}</title>
{% endblock extrahead %}
{% block content %}

    <div class="header">
        <h1 class="header-title">{{base_title}}</h1>

        <a href="/howto" class="index-instructions-link">Please read the instructions before starting!</a>

        <p class="user-info">
        {% if user != None %}
            Logged in as <b>{{user}}</b>
            <button id="logout-button">Log out</button>
        {% else %}
            <!--<button id="login-button">Log in</button>-->
            <a href="/login" style="font-weight: bold; text-decoration: none; color: black;">Login</a>
        {% endif %}
        </p>
    </div>
    <!-- <div class="radargram-index"> -->
    {% for glacier_key, glacier_radargrams in all_radargrams.items() %}
        <div class="index-location-group">
            <h2 class="index-location-title">{{glacier_radargrams._meta.nice_name}}</h2>
            <p>This glacier has a total of {{glacier_radargrams._meta.n_total_submissions}}  {{"submission" if glacier_radargrams._meta.n_total_submissions == 1 else "submissions"}}</p>
            <div class="index-dataset-container">
                {% for radar_key, values in glacier_radargrams.items() %}
                    {% if radar_key != "_meta" %}

                    <a href="/digitize/{{radar_key}}" class="index-card index-card-{% if user == None %}anonymous{% elif values.n_submitted_by_user > 0 %}finished{% else %}unfinished{% endif %}">
                        <div class="index-card-info">
                            <h3 class="index-card-title">{{radar_key}}</h3>
                            <p class="index-card-description">Done by {{values.n_total_submissions}} {{"person" if values.n_total_submissions == 1 else "people"}}.</p>
                            <p class="index-card-description">
                                {% if values.n_submitted_by_user >= 2 %}
                                    Done by you ({{values.n_submitted_by_user}}x)!
                                {% elif values.n_submitted_by_user == 1 %}
                                    Done by you!
                                {% else %}
                                    Not done by you
                                {% endif %}
                            </p>
                            <p class="index-card-description">Length: {{values.length_km_rounded}} km.</p>

                        </div>
                        <img loading="lazy" src="{{values.thumbnail}}"></img>
                    </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endfor %}
    <script src="{{ url_for('static', filename='index.js') }}"></script>
{% endblock content %}
